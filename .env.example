# Private Vercel environment variables. Use the token for the Mini App's bot.
BOT_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GUIDE_ADMIN_IDS=

# Optional. Only needed for a custom Mini App link.
# VITE_GUIDE_TMA_URL=https://t.me/NotWiseGuideBot?startapp

# Optional licensed Getgems Read API token. Without it, the watcher verifies
# completed Getgems purchases in public TON activity.
GETGEMS_READ_TOKEN=
TONCENTER_API_KEY=

# Optional linked discussion chat. Telegram membership checks need bot admin in this chat.
GUIDE_CHAT_ID=
# Verified live game mint quotes in GRAM keyed by item asset slug.
GAME_MINT_QUOTES_JSON=
# Verified count still mintable in-game keyed by album ID.
GAME_ALBUM_ISSUE_JSON=
# Shared secret for signed squad membership events from the game server only.
GUIDE_SQUAD_WEBHOOK_KEY=
